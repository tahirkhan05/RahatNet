rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // ---------------------------------------------------------------------------
    // Need photos — uploaded by citizens when reporting a need
    // ---------------------------------------------------------------------------
    match /need-photos/{userId}/{allPaths=**} {
      // Any authenticated user can read need photos (coordinators, volunteers).
      allow read: if request.auth != null;

      // Only the photo owner can upload; enforce size + MIME constraints.
      allow write: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size < 10 * 1024 * 1024          // max 10 MB
        && request.resource.contentType.matches('image/.*');  // images only
    }

    // ---------------------------------------------------------------------------
    // Profile photos — volunteer/coordinator avatars
    // ---------------------------------------------------------------------------
    match /profile-photos/{userId}/{allPaths=**} {
      allow read: if request.auth != null;

      allow write: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // ---------------------------------------------------------------------------
    // Field reports — PDFs / images uploaded by NGO coordinators
    // ---------------------------------------------------------------------------
    match /field-reports/{disasterId}/{allPaths=**} {
      allow read: if request.auth != null;

      // Any authenticated user can upload field reports.
      allow write: if request.auth != null
        && request.resource.size < 50 * 1024 * 1024          // max 50 MB
        && (
          request.resource.contentType.matches('image/.*') ||
          request.resource.contentType == 'application/pdf'
        );
    }

    // ---------------------------------------------------------------------------
    // Voice notes — recordings submitted with need reports
    // ---------------------------------------------------------------------------
    match /voice-notes/{userId}/{allPaths=**} {
      allow read: if request.auth != null;

      allow write: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size < 10 * 1024 * 1024          // max 10 MB
        && request.resource.contentType.matches('audio/.*');
    }

    // ---------------------------------------------------------------------------
    // Everything else — deny by default
    // ---------------------------------------------------------------------------
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
