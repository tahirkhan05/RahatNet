{
  "name": "@rahatnet/functions",
  "version": "1.0.0",
  "private": true,
  "description": "Firebase Cloud Functions for RahatNet AI pipeline and triggers",
  "engines": {
    "node": "20"
  },
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --max-warnings=0",
    "serve": "npm run build && firebase emulators:start --only functions",
    "deploy": "firebase deploy --only functions",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@rahatnet/types": "workspace:*",
    "@google/generative-ai": "^0.12.0",
    "firebase-admin": "^12.2.0",
    "firebase-functions": "^5.0.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@rahatnet/config": "workspace:*",
    "@types/node": "^20.14.2",
    "typescript": "^5.4.5"
  }
}
