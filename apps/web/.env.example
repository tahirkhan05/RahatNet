# ================================
# FIREBASE CLIENT (public — safe to expose)
# Get from: Firebase Console → Project Settings → General → Your apps
# ================================
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
NEXT_PUBLIC_FIREBASE_DATABASE_URL=

# ================================
# FIREBASE ADMIN (server only — NEVER prefix with NEXT_PUBLIC_)
# Get from: Firebase Console → Project Settings → Service Accounts → Generate new private key
# Then base64 encode: base64 -i serviceAccount.json | tr -d '\n'
# ================================
FIREBASE_SERVICE_ACCOUNT_BASE64=

# ================================
# GOOGLE CLOUD AI
# Get GEMINI_API_KEY from: https://aistudio.google.com/app/apikey
# ================================
GEMINI_API_KEY=
GOOGLE_CLOUD_PROJECT_ID=
GOOGLE_CLOUD_LOCATION=asia-south1
VERTEX_AI_ENDPOINT=        # Optional — Phase 2 custom model endpoint

# ================================
# GOOGLE MAPS
# Get from: Google Cloud Console → APIs & Services → Credentials
# Enable: Maps JS API, Geocoding API, Routes API, Distance Matrix API
# ================================
NEXT_PUBLIC_GOOGLE_MAPS_KEY=
GOOGLE_MAPS_SERVER_KEY=    # Same key, server-side only (no referrer restriction)

# ================================
# FCM (Firebase Cloud Messaging)
# Get VAPID key from: Firebase Console → Project Settings → Cloud Messaging → Web Push certificates
# ================================
NEXT_PUBLIC_FCM_VAPID_KEY=

# ================================
# SESSION
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# ================================
SESSION_SECRET=            # 128-char random hex
SESSION_COOKIE_NAME=rahatnet_session
SESSION_EXPIRY_DAYS=14

# ================================
# RATE LIMITING (Upstash Redis) — optional
# Get from: https://console.upstash.com
# ================================
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ================================
# ANALYTICS
# ================================
NEXT_PUBLIC_GA_MEASUREMENT_ID=   # Optional — Google Analytics 4 measurement ID
BIGQUERY_DATASET_ID=rahatnet_analytics

# ================================
# APP
# ================================
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_ENV=development
NODE_ENV=development
NEXT_PUBLIC_ACTIVE_DISASTER_ID=active-disaster-001
NEXT_PUBLIC_COORDINATOR_PHONE=   # Optional — shows as emergency contact to citizens/volunteers
