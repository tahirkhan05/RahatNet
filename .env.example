# ================================
# FIREBASE CLIENT (public — safe to expose in NEXT_PUBLIC_)
# ================================
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=rahatnet-prod.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=rahatnet-prod
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=rahatnet-prod.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
NEXT_PUBLIC_FIREBASE_DATABASE_URL=https://rahatnet-prod-default-rtdb.firebaseio.com

# ================================
# FIREBASE ADMIN (server only — NEVER prefix with NEXT_PUBLIC_)
# Base64-encode your service account: cat service-account.json | base64
# ================================
FIREBASE_SERVICE_ACCOUNT_BASE64=

# ================================
# GOOGLE CLOUD AI
# ================================
GEMINI_API_KEY=
GOOGLE_CLOUD_PROJECT_ID=rahatnet-prod
GOOGLE_CLOUD_LOCATION=asia-south1
VERTEX_AI_ENDPOINT=

# ================================
# GOOGLE MAPS
# ================================
NEXT_PUBLIC_GOOGLE_MAPS_KEY=
GOOGLE_MAPS_SERVER_KEY=

# ================================
# FCM (Firebase Cloud Messaging)
# ================================
NEXT_PUBLIC_FCM_VAPID_KEY=

# ================================
# SESSION
# Generate: openssl rand -hex 64
# ================================
SESSION_SECRET=
SESSION_COOKIE_NAME=rahatnet_session
SESSION_EXPIRY_DAYS=14

# ================================
# RATE LIMITING (Upstash Redis)
# ================================
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ================================
# ANALYTICS
# ================================
NEXT_PUBLIC_GA_MEASUREMENT_ID=
BIGQUERY_DATASET_ID=rahatnet_analytics

# ================================
# APP
# ================================
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_ENV=development
NODE_ENV=development
