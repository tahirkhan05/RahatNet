{
  "name": "@rahatnet/types",
  "version": "1.0.0",
  "private": true,
  "description": "Shared TypeScript type definitions for RahatNet",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "peerDependencies": {
    "firebase": ">=10.0.0"
  },
  "peerDependenciesMeta": {
    "firebase": {
      "optional": true
    }
  },
  "devDependencies": {
    "@rahatnet/config": "workspace:*",
    "firebase": "^10.12.1",
    "typescript": "^5.4.5"
  }
}
